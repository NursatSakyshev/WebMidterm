{
  "info": {
    "name": "Library API",
    "description": "Requests for every endpoint of the Library API.\n\nStart the app with `docker compose up --build`, then run the whole collection (Run collection) from top to bottom. The `Create book` request saves the new book's id into the `bookId` collection variable, and later requests use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "bookId", "value": "1" },
    { "key": "isbn", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Database is connected', () => {",
                  "  pm.expect(pm.response.json().database).to.eql('connected');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create book",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Random ISBN-13 so the request can be run many times without a 409 conflict",
                  "let digits = '978';",
                  "for (let i = 0; i < 10; i++) digits += Math.floor(Math.random() * 10);",
                  "pm.collectionVariables.set('isbn', digits);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const book = pm.response.json();",
                  "pm.test('Book has an id and the sent fields', () => {",
                  "  pm.expect(book.id).to.be.a('number');",
                  "  pm.expect(book.title).to.eql('Dune');",
                  "  pm.expect(book.available).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('bookId', book.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"{{isbn}}\",\n  \"publishedYear\": 1965,\n  \"genre\": \"Science Fiction\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "List books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response has data array and pagination', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.pagination.total).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "List books (filters + pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Only available Programming books are returned', () => {",
                  "  body.data.forEach((book) => {",
                  "    pm.expect(book.genre).to.eql('Programming');",
                  "    pm.expect(book.available).to.eql(true);",
                  "  });",
                  "});",
                  "pm.test('Limit is applied', () => pm.expect(body.data.length).to.be.at.most(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?genre=Programming&available=true&limit=5&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "genre", "value": "Programming" },
                { "key": "available", "value": "true" },
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "0" },
                { "key": "author", "value": "Martin", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get book by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the requested book', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('bookId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "Replace book (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const book = pm.response.json();",
                  "pm.test('All fields are replaced', () => {",
                  "  pm.expect(book.title).to.eql('Dune Messiah');",
                  "  pm.expect(book.publishedYear).to.eql(1969);",
                  "  pm.expect(book.available).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune Messiah\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"{{isbn}}\",\n  \"publishedYear\": 1969,\n  \"genre\": \"Science Fiction\",\n  \"available\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "Update book (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const book = pm.response.json();",
                  "pm.test('Only the sent field changed', () => {",
                  "  pm.expect(book.available).to.eql(true);",
                  "  pm.expect(book.title).to.eql('Dune Messiah');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"available\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "Delete book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "Get deleted book (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('Book not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Create book - validation error (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lists every problem', () => {",
                  "  const details = pm.response.json().details;",
                  "  pm.expect(details).to.include('author is required');",
                  "  pm.expect(details.length).to.be.at.least(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"publishedYear\": \"long ago\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "Create book - duplicate ISBN (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code (copy)\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"978-0132350884\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "Get book - invalid id (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/books/abc", "host": ["{{baseUrl}}"], "path": ["api", "books", "abc"] }
          }
        },
        {
          "name": "Update book - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"available\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/books/999999", "host": ["{{baseUrl}}"], "path": ["api", "books", "999999"] }
          }
        }
      ]
    }
  ]
}
